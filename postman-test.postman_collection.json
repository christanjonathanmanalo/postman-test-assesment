{
  "info": {
    "_postman_id": "postman-test-assessment",
    "name": "postman-test",
    "description": "Postman API testing assessment collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /token",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test(\"Access token is returned\", function () {",
              "    pm.expect(response.accessToken).to.exist;",
              "    pm.expect(response.accessToken).to.be.a(\"string\");",
              "});",
              "",
              "pm.test(\"Token type is Bearer\", function () {",
              "    pm.expect(response.tokenType).to.eql(\"Bearer\");",
              "});",
              "",
              "pm.environment.set(\"token\", response.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /users",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Response is an array\", function () {",
              "    pm.expect(response).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"User has required fields\", function () {",
              "    const user = response[0];",
              "",
              "    pm.expect(user).to.have.property(\"id\");",
              "    pm.expect(user).to.have.property(\"name\");",
              "    pm.expect(user).to.have.property(\"email\");",
              "});",
              "",
              "pm.test(\"User ID matches requested ID\", function () {",
              "    const user = response[0];",
              "",
              "    pm.expect(String(user.id)).to.eql(String(pm.environment.get(\"userId\")));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /users/{userId}",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains requested user\", function () {",
              "    pm.expect(String(response.id)).to.eql(String(pm.environment.get(\"userId\")));",
              "});",
              "",
              "pm.test(\"User has required fields\", function () {",
              "    pm.expect(response).to.have.property(\"name\");",
              "    pm.expect(response).to.have.property(\"email\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /users",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"nickName\": \"Test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const responseText = pm.response.text();",
              "",
              "pm.test(\"Response contains receivedData\", function () {",
              "    pm.expect(responseText).to.include(\"receivedData\");",
              "});",
              "",
              "pm.test(\"Response contains submitted name\", function () {",
              "    pm.expect(responseText).to.include(\"Test User\");",
              "});",
              "",
              "pm.test(\"Response contains submitted email\", function () {",
              "    pm.expect(responseText).to.include(\"testuser@example.com\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /users",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated User\",\n  \"email\": \"updateduser@example.com\",\n  \"nickName\": \"Updated\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const responseText = pm.response.text();",
              "",
              "pm.test(\"Response contains receivedData\", function () {",
              "    pm.expect(responseText).to.include(\"receivedData\");",
              "});",
              "",
              "pm.test(\"Response contains updated name\", function () {",
              "    pm.expect(responseText).to.include(\"Updated User\");",
              "});",
              "",
              "pm.test(\"Response contains updated email\", function () {",
              "    pm.expect(responseText).to.include(\"updateduser@example.com\");",
              "});",
              "",
              "pm.test(\"Response contains updated nickname\", function () {",
              "    pm.expect(responseText).to.include(\"Updated\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE /users/{userId}",
      "request": {
        "method": "DELETE",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test(\"Response contains success message\", function () {",
              "    pm.expect(response.message).to.eql(\"User deleted successfully\");",
              "});",
              "",
              "pm.test(\"Deleted user ID is correct\", function () {",
              "    pm.expect(String(response.id)).to.eql(String(pm.environment.get(\"userId\")));",
              "});"
            ]
          }
        }
      ]
    }
  ]
}